{
	"name": "plugboard",
	"version": "0.1.0",
	"description": "Cascading connections & credentials for AI coding agents",
	"type": "module",
	"license": "MIT",
	"bin": {
		"plugboard": "./dist/cli.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./schema.json": "./schema.json"
	},
	"files": [
		"dist",
		"schema.json",
		"schemas"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsdown && bun scripts/gen-schema.ts && bun scripts/postbuild.ts",
		"check": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^2.23.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"jsonc-parser": "^3.3.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/bun": "^1.3.8",
		"citty": "^0.2.2",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3"
	}
}
